# Unreal build products and local editor state.
/.vs/
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
/Build/Windows/FileOpenOrder/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.vcxproj
*.vcxproj.filters
/UpgradeLog.htm
__pycache__/
*.pyc

# Delivery binaries, complete private backups, and old integration workspaces.
/Packaged*/
/Backups/
/Backup/
/R6Staging/
/R6CatalogProofPatch/

# Preserve only small reusable evidence inputs and audit receipts.
/Evidence/*
!/Evidence/ArmsPoseSample.json
!/Evidence/R6_DeliveryManifest.json
!/Evidence/R7_PreflightReceipt.json

# Downloads is mostly archives/cache. Explicit exceptions support existing
# packaging and import scripts without retaining cached purchase/web pages.
/Downloads/**
